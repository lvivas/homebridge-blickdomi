{
  "name": "homebridge-blickdomi",
  "displayName": "Homebridge BlickDomi",
  "version": "0.3.7",
  "description": "Control BlickDomi Sentry window shutters (Solven) from HomeKit via the mySmartWindow cloud API.",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.8.0"
  },
  "keywords": [
    "homebridge-plugin",
    "blickdomi",
    "solven",
    "mysmartwindow",
    "shutter",
    "windowcovering"
  ],
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@aws-sdk/client-iot-data-plane": "^3.1154.0",
    "aws-iot-device-sdk": "^2.2.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "homebridge": "^1.8.5",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  }
}
